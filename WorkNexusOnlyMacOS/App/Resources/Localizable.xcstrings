    "diagnosticsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors and the steps before them are kept on this Mac for 7 days, to trace problems. Nothing is sent anywhere. Passwords, tokens and the text of messages and tickets are never recorded."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lỗi và các bước ngay trước đó được lưu trên máy này 7 ngày để truy vết sự cố. Không gửi đi đâu. Mật khẩu, token và nội dung tin nhắn, ticket không bao giờ được ghi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误及其之前的操作步骤会在这台 Mac 上保留 7 天，用于排查问题。不会发送到任何地方。绝不记录密码、令牌以及消息和工单的正文。"
          }
        }
      }
    },
