    "certPromptMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nIts certificate %2$@.\n\nIf you trust this site, for example your own company's server, the app remembers it and stops asking. Anyone able to intercept your connection to it could then read what you send."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nChứng chỉ của trang %2$@.\n\nNếu bạn tin trang này, ví dụ máy chủ của chính công ty bạn, ứng dụng sẽ nhớ và không hỏi nữa. Ai chặn được kết nối của bạn tới trang đó khi ấy có thể đọc những gì bạn gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\n其证书%2$@。\n\n如果你信任此网站（例如你公司自己的服务器），应用会记住它并不再询问。之后任何能够拦截你与该网站连接的人都可能读取你发送的内容。"
          }
        }
      }
    },
    "certReasonDates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "has expired, or is not valid yet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "đã hết hạn hoặc chưa có hiệu lực"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已过期或尚未生效"
          }
        }
      }
    },
    "certReasonName": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "was issued for a different site name"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "được cấp cho một tên trang khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颁发给了其他网站名称"
          }
        }
      }
    },
    "certReasonAuthority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "was not issued by an authority this computer trusts (it may be self-signed)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không do một tổ chức mà máy tính này tin cậy cấp (có thể là tự ký)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "并非由此电脑信任的机构颁发（可能是自签名证书）"
          }
        }
      }
    },
    "certReasonOther": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "is not valid (%1$@)"
          }
