    "appTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task Board"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Task Board"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务看板"
          }
        }
      }
    },
    "updateAvailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkNexus %1$@ is available."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có phiên bản WorkNexus %1$@ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkNexus %1$@ 已可用。"
          }
        }
      }
    },
    "updateRestartToUpdate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart to update to %1$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại để cập nhật lên %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动以更新到 %1$@"
          }
        }
      }
    },
    "trayOpenApp": {
      "extractionState": "manual",
      "localizations": {
