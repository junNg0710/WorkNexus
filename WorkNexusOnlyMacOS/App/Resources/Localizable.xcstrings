    "miniAppTrustedCertsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sites whose invalid certificate you chose to trust. They load without asking again, until you forget them here. Windows only."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trang mà bạn đã chọn tin cậy dù chứng chỉ không hợp lệ. Chúng tải mà không hỏi lại cho tới khi bạn quên chúng ở đây. Chỉ Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择信任其无效证书的网站。它们将直接加载而不再询问，直到你在此处移除。仅限 Windows。"
          }
        }
      }
    },
