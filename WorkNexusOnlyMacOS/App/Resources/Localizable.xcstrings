    "miniAppLiveLimitHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past this, the app left longest ago closes and reopens where it was when you come back. Fewer uses less memory."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vượt quá số này, app bỏ lâu nhất sẽ đóng và mở lại đúng trang cũ khi bạn quay lại. Ít app hơn thì tốn ít bộ nhớ hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出此数量时，最久未使用的应用将关闭，返回时会恢复到原来的位置。数量越少，占用内存越少。"
          }
        }
      }
    },
    "miniAppNotifyBackgroundLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep apps that notify running"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ app có thông báo chạy nền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持发送通知的应用运行"
          }
        }
      }
    },
    "miniAppNotifyBackgroundHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: hidden apps pause, and their notifications wait until you open them."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt: app bị ẩn sẽ tạm dừng, thông báo của nó chỉ đến khi bạn mở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时：隐藏的应用会暂停，其通知会等到你打开时才显示。"
          }
        }
      }
    },
