        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js %1$@ quá cũ: MCP server cần bản %2$@ trở lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js %1$@ 版本过旧：MCP 服务器需要 %2$@ 或更高版本。"
          }
        }
      }
    },
    "mcpSetupNodeMissing": {
      "extractionState": "manual",
