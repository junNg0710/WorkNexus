    "zentaoConnectionSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your ZenTao server URL and login. Your password is stored in the macOS Keychain — never in the local database."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập URL máy chủ ZenTao và thông tin đăng nhập. Mật khẩu được lưu trong macOS Keychain — không bao giờ lưu vào cơ sở dữ liệu cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 ZenTao 服务器 URL 和登录信息。密码保存在 macOS 钥匙串中，绝不存入本地数据库。"
          }
        }
