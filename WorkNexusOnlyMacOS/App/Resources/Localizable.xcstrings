    "githubConfirmMergeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merges %1$@ into %2$@ and cannot be undone from here."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này merge %1$@ vào %2$@ và không thể hoàn tác từ đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将 %1$@ 合并到 %2$@，且无法在此撤销。"
          }
        }
      }
    },
