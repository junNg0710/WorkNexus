        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng các ticket đã chọn mà ZenTao cho đóng (bug đã resolve, task đã xong hoặc đã hủy); còn lại bị bỏ qua"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
