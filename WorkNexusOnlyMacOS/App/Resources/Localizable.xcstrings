    "certPromptMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nIts certificate %2$@.\n\nIf you trust this site, for example your own company's server, the app remembers it and stops asking. Anyone able to intercept your connection to it could then read what you send."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\n\nChứng chỉ của trang %2$@.\n\nNếu bạn tin trang này, ví dụ máy chủ của chính công ty bạn, ứng dụng sẽ nhớ và không hỏi nữa. Ai chặn được kết nối của bạn tới trang đó khi ấy có thể đọc những gì bạn gửi."
          }
        }
      }
    },
