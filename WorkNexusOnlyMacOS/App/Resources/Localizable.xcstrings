    "appUpdatesTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App updates"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật ứng dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用更新"
          }
        }
      }
    },
    "appUpdatesSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable updates are checked every hour and downloaded in the background. Once one is ready, the button above Integrations restarts into it. You can also check now."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng tự kiểm tra bản stable mỗi giờ và tải sẵn về. Khi đã sẵn sàng, nút phía trên Kết nối sẽ khởi động lại với phiên bản mới. Bạn cũng có thể kiểm tra ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时检查一次稳定版更新，并在后台下载。下载完成后，点击“集成”上方的按钮即可重新启动并完成更新。你也可以立即检查。"
          }
        }
      }
    },
    "checkForUpdates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新"
          }
        }
      }
    },
    "autoUpdateLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update automatically"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động cập nhật"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新"
          }
        }
      }
    },
    "autoUpdateHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for new stable versions every hour and download them in the background. Off, the app only looks when you press Check for updates. It never installs without you restarting into it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giờ kiểm tra bản stable mới và tải sẵn ở nền. Khi tắt, ứng dụng chỉ kiểm tra khi bạn bấm Kiểm tra cập nhật. Nó không bao giờ tự cài khi bạn chưa khởi động lại vào bản mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每小时检查新的稳定版本并在后台下载。关闭后，只有点击“检查更新”时才会检查。未经你重新启动，应用绝不会自行安装更新。"
          }
        }
      }
    },
    "autoUpdateSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the automatic update choice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không lưu được lựa chọn cập nhật tự động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存自动更新设置。"
