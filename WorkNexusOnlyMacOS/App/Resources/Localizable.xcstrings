    "mcpSetupSendNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading what WorkNexus already stored works right away. To let the assistant send messages, load older history and open files and images, also turn on \"Let local AI tools use chat\" below. WorkNexus must be running for that."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc tin WorkNexus đã lưu dùng được ngay. Muốn trợ lý gửi tin, tải thêm tin cũ và mở file, ảnh thì bật thêm \"Cho công cụ AI trên máy dùng chat\" bên dưới, và WorkNexus phải đang chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取 WorkNexus 已存储的内容可立即使用。若要让助手发送消息、加载更早的历史记录并打开文件和图片，还需开启下方的“允许本地 AI 工具使用聊天”。此时 WorkNexus 必须保持运行。"
          }
        }
      }
    },
    "chatReactions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reactions"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
