    "tipPet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to wave, drag to move it. Choose another pet or turn it off in Settings › Pet"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm để vẫy tay, kéo để đổi chỗ. Đổi thú cưng hoặc tắt trong Cài đặt › Thú cưng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
