    "diagnosticsFpsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a small badge in the bottom corner of the window: the frames drawn in the last second and the longest wait between two of them. Green is smooth, amber uneven, red slow. Uses a little more power while on."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện một nhãn nhỏ ở góc dưới cửa sổ: số khung hình vẽ trong giây vừa qua và khoảng chờ dài nhất giữa hai khung. Xanh là mượt, vàng là không đều, đỏ là chậm. Tốn thêm chút pin khi bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在窗口底角显示一个小标记：最近一秒绘制的帧数，以及两帧之间的最长间隔。绿色表示流畅，琥珀色表示不稳定，红色表示缓慢。开启时会略微增加耗电。"
          }
        }
      }
    },
    "dropFilesOnForm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop images to put in the description, other files to attach"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả ảnh để chèn vào mô tả, file khác sẽ được đính kèm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖入图片会插入到描述中，其他文件将作为附件"
          }
        }
      }
    },
