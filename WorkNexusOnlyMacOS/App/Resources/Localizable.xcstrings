    "panicSwitchPetEnabledHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: on this computer the pet does not set it off, nothing is sent and arriving stickers are ignored."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt thì trên máy này pet không kích hoạt được, không gửi gì và cũng không phản ứng khi nhận sticker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：在这台电脑上，宠物不会触发，不会发送任何内容，收到的贴纸也会被忽略。"
          }
        }
      }
    },
    "panicSwitchPetTabHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pet sets it off, in the window or on the desktop. The pet must be shown (Settings › Pet)."
