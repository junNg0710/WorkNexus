    "miniAppCookiesOnlyChrome": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only Chrome was found, and importing from Chrome is not supported on Windows: Chrome encrypts its cookies so that only Chrome can read them. Sign in to the site in Edge or Firefox, then import from there."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tìm thấy Chrome, mà Windows không hỗ trợ import từ Chrome: Chrome mã hoá cookie để chỉ chính Chrome đọc được. Hãy đăng nhập trang đó bằng Edge hoặc Firefox rồi import từ trình duyệt đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅找到 Chrome，而 Windows 上不支持从 Chrome 导入：Chrome 对其 Cookie 进行了加密，只有 Chrome 自身能读取。请在 Edge 或 Firefox 中登录该站点，然后从那里导入。"
          }
        }
      }
    },
