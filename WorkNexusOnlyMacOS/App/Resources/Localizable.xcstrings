      }
    },
    "chatTrustGateBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ uses its own certificate. Confirm it once and chat connects; until then, chat stays off."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dùng chứng chỉ riêng. Xác nhận một lần là chat kết nối; trước đó chat chưa dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用自己的证书。确认一次后即可连接聊天；在此之前，聊天保持关闭。"
          }
        }
      }
    },
