          "stringUnit": {
            "state": "translated",
            "value": "macOS did not give out %1$@'s cookie key. Try again and choose Allow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chưa cho đọc khoá cookie của %1$@. Thử lại và chọn Cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
