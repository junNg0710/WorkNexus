        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một nhà cung cấp có thể được kết nối nhiều lần — mỗi công ty một tài khoản. Công việc được giao cho bạn sẽ được lấy từ mọi tài khoản bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一服务可多次连接，每家公司一个。下方所有账号中指派给你的任务都会被拉取。"
          }
