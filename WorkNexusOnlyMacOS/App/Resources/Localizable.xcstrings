          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy Node.js. Cài Node.js %1$@ trở lên rồi mở lại hướng dẫn này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Node.js。请安装 Node.js %1$@ 或更高版本，然后重新打开本指南。"
          }
        }
      }
    },
    "mcpSetupNodeVersionManager": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Node.js belongs to one version of a version manager (nvm, fnm, asdf, …). If you switch away from or remove that version, the AI tool can no longer start the server: open this guide again and register it with the new path."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js này thuộc một phiên bản của trình quản lý phiên bản (nvm, fnm, asdf, …). Nếu đổi sang hoặc gỡ phiên bản đó, công cụ AI sẽ không chạy được server nữa: mở lại hướng dẫn này và đăng ký lại với đường dẫn mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Node.js 属于版本管理器（nvm、fnm、asdf 等）中的某个版本。如果切换或移除该版本，AI 工具将无法启动服务器：请重新打开本指南，用新路径重新注册。"
          }
        }
      }
    },
    "mcpSetupGetNode": {
      "extractionState": "manual",
      "localizations": {
