    "panicSwitchPetHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the pet three times to send the sticker; once it is sent, your apps switch too. The pet must be shown (Settings › Pet)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm vào pet 3 lần để gửi sticker; gửi thành công thì máy bạn cũng chuyển app luôn. Cần bật pet (Cài đặt › Pet)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按宠物三次即可发送贴纸；发送后，你的 App 也会切换。宠物必须处于显示状态（设置 › 宠物）。"
          }
        }
      }
    },
    "panicSwitchPetGestureHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the pet (for the seconds set below), or click it three times, to send the sticker; once it is sent, your apps switch too. The pet must be shown (Settings › Pet)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn giữ pet (số giây chọn bên dưới) hoặc bấm pet 3 lần để gửi sticker; gửi thành công thì máy bạn cũng chuyển app luôn. Cần bật pet (Cài đặt › Pet)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住宠物（按下方设置的秒数）或点按三次即可发送贴纸；发送后，你的 App 也会切换。宠物必须处于显示状态（设置 › 宠物）。"
          }
        }
      }
    },
    "panicSwitchPetHold": {
      "extractionState": "manual",
