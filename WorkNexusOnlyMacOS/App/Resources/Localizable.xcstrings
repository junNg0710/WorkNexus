        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "không hợp lệ (%1$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无效（%1$@）"
          }
        }
      }
    },
