    "mcpSetupIntro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkNexus comes with an MCP server: add it to Claude or another MCP-capable assistant, and it can list, read and search your ZenTao chats (and TBChat, when installed), send messages, load older history and open files and images."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkNexus có sẵn một MCP server: thêm nó vào Claude hoặc trợ lý AI khác hỗ trợ MCP để xem danh sách, đọc, tìm tin chat ZenTao (và TBChat nếu máy có cài), gửi tin, tải thêm tin cũ và mở file, ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "WorkNexus 自带 MCP 服务器：将其添加到 Claude 或其他支持 MCP 的助手后，即可列出、阅读和搜索你的 ZenTao 会话（以及已安装的 TBChat），发送消息，加载更早的历史记录，并打开文件和图片。"
          }
        }
      }
    },
    "mcpSetupNodeFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
