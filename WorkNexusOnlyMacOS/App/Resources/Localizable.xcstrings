    "tipBulkClose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the selected tickets ZenTao lets be closed (a resolved bug, a finished or cancelled task); the others are skipped"
          }
