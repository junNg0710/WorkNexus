    "aiProvidersSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode and Claude Code use their own CLI login, no key needed; the others use your own API key, kept in the Keychain. Save as many as you like."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode và Claude Code dùng đăng nhập sẵn có của CLI, không cần khoá; các nhà cung cấp khác dùng API key của bạn, lưu trong Keychain. Lưu bao nhiêu tuỳ ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode 和 Claude Code 使用各自的 CLI 登录，无需密钥；其他提供商使用你自己的 API 密钥，保存在钥匙串中。可保存任意多个。"
          }
        }
      }
    },
