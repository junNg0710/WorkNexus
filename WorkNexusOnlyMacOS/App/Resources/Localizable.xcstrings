    "nativeAppBadgeOfferLost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS stopped letting WorkNexus read the Dock's badges - an update counts as a new app. In Privacy & Security → Accessibility, remove WorkNexusMac with −, then add it again and turn it on."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS đã ngừng cho WorkNexus đọc badge trên Dock - mỗi bản cập nhật được coi là một app mới. Trong Privacy & Security → Accessibility, xoá WorkNexusMac bằng nút −, rồi thêm lại và bật lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 已不再允许 WorkNexus 读取程序坞的标记——更新后会被视为新 App。请在“隐私与安全性 → 辅助功能”中用 − 移除 WorkNexusMac，然后重新添加并打开它。"
          }
        }
      }
    },
    "nativeAppBadgeOfferMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac apps on the rail can show the same unread count as their Dock icon. macOS allows that only to apps turned on under Privacy & Security → Accessibility."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các app Mac trên rail có thể hiện số chưa đọc giống icon trên Dock. macOS chỉ cho phép khi WorkNexusMac được bật trong Privacy & Security → Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧栏上的 Mac App 可显示与其程序坞图标相同的未读数。macOS 只允许在“隐私与安全性 → 辅助功能”中已打开的 App 这样做。"
          }
        }
      }
    },
