    "chatLocalApi": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let local AI tools use chat"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho công cụ AI trên máy dùng chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许本地 AI 工具使用聊天"
          }
        }
      }
    },
    "chatLocalApiHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs on this computer, such as an AI assistant's MCP server, can send chat messages as you, load older history and download files and images through this app, without your password. Only turn this on for tools you trust."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chương trình trên máy này, như MCP server của trợ lý AI, có thể gửi tin chat dưới tên bạn, tải thêm tin cũ và tải file, ảnh qua app này mà không cần mật khẩu. Chỉ bật khi bạn tin công cụ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑上的程序（例如 AI 助手的 MCP 服务器）可以通过本应用以你的身份发送消息、加载更早的历史记录、下载文件和图片，无需你的密码。仅对你信任的工具开启。"
          }
        }
      }
    },
    "mcpSetupOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
