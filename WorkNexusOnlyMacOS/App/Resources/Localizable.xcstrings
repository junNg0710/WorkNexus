    "claudeCodeNotInstalledBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs on Claude Code, but the claude command was not found. Install Claude Code and sign in, or pick another provider under Settings → Translation."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này chạy bằng Claude Code nhưng không tìm thấy lệnh claude. Hãy cài Claude Code và đăng nhập, hoặc chọn nhà cung cấp khác trong Cài đặt → Dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能使用 Claude Code，但未找到 claude 命令。请安装 Claude Code 并登录，或在“设置 → 翻译”中选择其他提供商。"
          }
        }
      }
    },
