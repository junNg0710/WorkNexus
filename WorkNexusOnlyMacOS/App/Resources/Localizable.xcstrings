            "state": "translated",
            "value": "此账号已在其他地方登录，你已被退出登录。"
          }
        }
      }
    },
    "chatReviewCertificate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review certificate"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem chứng chỉ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看证书"
          }
        }
      }
    },
    "chatTrustTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the chat server"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận máy chủ chat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认聊天服务器"
          }
        }
      }
    },
    "chatTrustBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ secures chat with its own (self-signed) certificate, not one your system already trusts, so WorkNexus checks with you once before connecting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bảo vệ kết nối chat bằng chứng chỉ riêng (tự ký), không phải loại hệ điều hành đã tin cậy sẵn, nên WorkNexus cần bạn xác nhận một lần trước khi kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 使用自己的（自签名）证书保护聊天，而不是系统已信任的证书，因此 WorkNexus 会在连接前向你确认一次。"
          }
        }
      }
    },
    "chatTrustFingerprint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-256 fingerprint"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint SHA-256"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-256 指纹"
          }
        }
      }
    },
    "chatTrustIssuer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issued by"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp bởi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颁发者"
          }
        }
      }
    },
    "chatTrustAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust and connect"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin cậy và kết nối"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信任并连接"
          }
        }
      }
    },
    "chatTrustWhy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why am I asked?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao cần bước này?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么要确认？"
          }
        }
      }
    },
    "chatTrustWhyOnce": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only once. WorkNexus remembers this exact certificate and connects on its own after that."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hỏi một lần. WorkNexus ghi nhớ đúng chứng chỉ này và tự kết nối những lần sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需一次。WorkNexus 会记住这份证书，之后自动连接。"
          }
        }
      }
    },
    "chatTrustWhyChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it ever changes unexpectedly, you are asked again instead of being connected silently. A changed certificate can mean someone is intercepting the connection."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu chứng chỉ bất ngờ thay đổi, bạn sẽ được hỏi lại thay vì âm thầm kết nối. Chứng chỉ đổi có thể là dấu hiệu ai đó đang chặn kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果证书意外变更，会再次询问你，而不是静默连接。证书变更可能意味着有人在拦截连接。"
          }
        }
      }
    },
    "chatTrustWhyCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? Ask your ZenTao administrator to confirm the fingerprint below."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chắc? Nhờ quản trị viên ZenTao xác nhận fingerprint bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不确定？请让 ZenTao 管理员核对下方的指纹。"
          }
        }
      }
    },
    "chatTrustDetails": {
      "extractionState": "manual",
