    "nativeAppBadgeSettingsOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: macOS has not let WorkNexus read the Dock. Turn WorkNexusMac on under Privacy & Security → Accessibility. Already on there? Remove it with − and add it again - an update counts as a new app."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang tắt: macOS chưa cho WorkNexus đọc Dock. Bật WorkNexusMac trong Privacy & Security → Accessibility. Đã bật rồi? Xoá bằng nút − và thêm lại - mỗi bản cập nhật được coi là một app mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭：macOS 未允许 WorkNexus 读取程序坞。请在“隐私与安全性 → 辅助功能”中打开 WorkNexusMac。已经打开了？用 − 移除后重新添加——更新后会被视为新 App。"
          }
        }
      }
    },
