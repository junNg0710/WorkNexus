    },
    "tipLoadAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the rest of the open views, so the counts and filters cover every ticket and not only the first pages"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc nốt các view đang mở để số đếm và bộ lọc tính trên mọi ticket, không chỉ các trang đầu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取已打开视图的其余部分，使计数和筛选覆盖所有工单，而不只是前几页"
          }
        }
      }
    },
    "tipNewBug": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File a new bug in the open product"
          }
