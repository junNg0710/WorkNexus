    "miniAppCookiesKeychainTimeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS got no answer to the prompt for %1$@'s cookie key. It may be behind this window, or on another desktop while the app is full screen. Try again and choose Allow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chưa nhận được câu trả lời cho hộp thoại khoá cookie của %1$@. Hộp thoại có thể bị che sau cửa sổ này, hoặc nằm ở desktop khác khi app đang full-screen. Thử lại và chọn Cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 未收到对 %1$@ Cookie 密钥请求的响应。该提示可能位于此窗口后面，或在应用全屏时位于另一个桌面上。请重试并选择“允许”。"
          }
        }
      }
    },
