    "chatPrivacyModeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides chats on screen until you point at them, for a shared screen or a look over your shoulder: names and previews turn into dots, avatars into a placeholder, messages fade out. Nothing stored or sent changes. Shortcut: %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn chat trên màn hình cho tới khi bạn rê chuột vào, khi chia sẻ màn hình hay có người nhìn qua vai: tên và xem trước thành dấu chấm, ảnh đại diện thành ảnh mặc định, tin nhắn mờ đi. Không thay đổi dữ liệu đã lưu hay đã gửi. Phím tắt: %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在共享屏幕或有人从你身后看时，隐藏屏幕上的会话，直到鼠标指向它们：名称和预览变成圆点，头像变成占位图，消息淡出。存储和发送的内容不受影响。快捷键：%1$@。"
          }
        }
      }
    },
    "chatHidePreviews": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
