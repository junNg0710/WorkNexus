    "miniAppCookiesKeychainHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask to let WorkNexus read %1$@'s cookie key: choose Allow."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS sẽ hỏi quyền cho WorkNexus đọc khoá cookie của %1$@: hãy chọn Cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会请求允许 WorkNexus 读取 %1$@ 的 Cookie 密钥：请选择“允许”。"
          }
        }
      }
    },
    "miniAppCookiesKeychainDenied": {
      "extractionState": "manual",
      "localizations": {
