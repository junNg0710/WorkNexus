    "localCacheTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local database"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Database cục bộ"
          }
        }
      }
    },
    "localCacheSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded chat files and what your accounts sync are kept on this device, so the app opens fast and works offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "File chat đã tải và dữ liệu sync từ các tài khoản được lưu trên máy để app mở nhanh và dùng được khi offline."
          }
        }
      }
    },
    "localCacheHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Out-of-date or broken data? Clear the cache and sync again."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu cũ hoặc bị lỗi? Xoá cache rồi sync lại."
          }
        }
      }
    },
    "localCacheDbHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies of what your accounts sync, kept in this device's local database so the app opens fast and works offline. Clearing a part deletes only the local copy; it downloads again from your accounts."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao dữ liệu sync từ các tài khoản, lưu trong database cục bộ trên máy để app mở nhanh và dùng được khi offline. Xoá một phần chỉ xoá bản sao trên máy; app sẽ tải lại từ tài khoản."
          }
        }
      }
    },
    "clearCacheKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accounts, workspaces, settings and saved filters are kept."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản, workspace, cài đặt và bộ lọc đã lưu được giữ nguyên."
          }
        }
      }
    },
