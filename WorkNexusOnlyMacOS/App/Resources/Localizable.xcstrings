    "chatTrustTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the chat server"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận máy chủ chat"
          }
        }
      }
    },
    "chatTrustBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ secures chat with its own (self-signed) certificate, not one your system already trusts, so WorkNexus checks with you once before connecting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bảo vệ kết nối chat bằng chứng chỉ riêng (tự ký), không phải loại hệ điều hành đã tin cậy sẵn, nên WorkNexus cần bạn xác nhận một lần trước khi kết nối."
          }
        }
      }
    },
    "chatTrustFingerprint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-256 fingerprint"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingerprint SHA-256"
          }
        }
      }
    },
    "chatTrustIssuer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Issued by"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp bởi"
          }
        }
      }
    },
    "chatTrustAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust and connect"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin cậy và kết nối"
          }
        }
      }
    },
    "chatTrustWhy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why am I asked?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao cần bước này?"
          }
        }
      }
    },
    "chatTrustWhyOnce": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only once. WorkNexus remembers this exact certificate and connects on its own after that."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hỏi một lần. WorkNexus ghi nhớ đúng chứng chỉ này và tự kết nối những lần sau."
          }
        }
      }
    },
    "chatTrustWhyChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If it ever changes unexpectedly, you are asked again instead of being connected silently. A changed certificate can mean someone is intercepting the connection."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu chứng chỉ bất ngờ thay đổi, bạn sẽ được hỏi lại thay vì âm thầm kết nối. Chứng chỉ đổi có thể là dấu hiệu ai đó đang chặn kết nối."
          }
        }
      }
    },
    "chatTrustWhyCheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure? Ask your ZenTao administrator to confirm the fingerprint below."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chắc? Nhờ quản trị viên ZenTao xác nhận fingerprint bên dưới."
          }
        }
      }
    },
