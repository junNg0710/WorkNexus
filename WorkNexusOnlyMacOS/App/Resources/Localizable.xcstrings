            "value": "存储与缓存"
          }
        }
      }
    },
    "storageOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage storage…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý bộ nhớ…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理存储…"
          }
