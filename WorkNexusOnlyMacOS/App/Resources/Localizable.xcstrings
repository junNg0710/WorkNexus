    "githubConfirmCloseBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pull request will be closed without merging. You can reopen it later."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request sẽ được đóng mà không merge. Bạn có thể mở lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该拉取请求将被关闭而不合并。你可以稍后重新打开。"
          }
        }
      }
    },
