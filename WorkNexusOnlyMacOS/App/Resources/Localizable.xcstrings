    "appUpdatesSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stable updates are checked every hour and downloaded in the background. Once one is ready, the button above Integrations restarts into it. You can also check now."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng tự kiểm tra bản stable mỗi giờ và tải sẵn về. Khi đã sẵn sàng, nút phía trên Kết nối sẽ khởi động lại với phiên bản mới. Bạn cũng có thể kiểm tra ngay."
          }
        }
      }
    },
    "checkForUpdates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for updates"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra cập nhật"
          }
        }
      }
    },
    "autoUpdateLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update automatically"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động cập nhật"
          }
        }
      }
    },
    "autoUpdateHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look for new stable versions every hour and download them in the background. Off, the app only looks when you press Check for updates. It never installs without you restarting into it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi giờ kiểm tra bản stable mới và tải sẵn ở nền. Khi tắt, ứng dụng chỉ kiểm tra khi bạn bấm Kiểm tra cập nhật. Nó không bao giờ tự cài khi bạn chưa khởi động lại vào bản mới."
          }
        }
      }
    },
    "autoUpdateSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
