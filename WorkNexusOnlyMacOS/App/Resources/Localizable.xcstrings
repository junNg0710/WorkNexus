    "leaderHelpBulk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Act on the pick: Assign…, Priority… or Close… from the bar at the bottom. It says what will change and what is skipped first, then runs ticket by ticket; failed ones can be retried."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác trên phần đã chọn: Assign…, Priority… hoặc Close… ở thanh dưới cùng. Có báo trước cái nào sẽ đổi, cái nào bị bỏ qua, rồi chạy từng ticket; cái lỗi có thể thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所选项操作：从底部栏选择“指派…”、“优先级…”或“关闭…”。会先说明将更改和跳过的内容，然后逐个工单执行；失败的可以重试。"
          }
        }
      }
    },
    "leaderHelpChips": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chips: one-click filters (overdue, due soon, unassigned, high priority…). The number is how many each would keep. Overdue and due-soon count by calendar day."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chip: lọc một cú bấm (trễ hạn, sắp đến hạn, chưa giao, ưu tiên cao…). Con số là số ticket còn lại nếu bấm. Trễ hạn/sắp đến hạn tính theo ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选标签：一键筛选（已逾期、即将到期、未指派、高优先级…）。数字表示各自会保留的数量。已逾期和即将到期按日历日计算。"
          }
        }
      }
    },
    "leaderHelpFilter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter box: narrows the board as you type, by id, title or person. ⌘K searches every cached ticket of the account, and an id that isn't cached (#123) can be looked up on the server with Return."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ô lọc: thu hẹp board khi gõ, theo id, tiêu đề hoặc người. ⌘K tìm trên mọi ticket đã cache của tài khoản; gõ id chưa có (#123) rồi nhấn Return để tìm trên máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选框：输入时按 ID、标题或人员缩小看板范围。⌘K 搜索该账户所有已缓存的工单；未缓存的 ID（#123）可按回车键在服务器上查找。"
          }
        }
      }
    },
    "leaderHelpHours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards show the hours left, and a tag for how late or how close the deadline is. Sort: deadline puts the most overdue first."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thẻ hiện số giờ còn lại và tag trễ/sắp đến hạn. Sort: deadline xếp việc trễ nhất lên đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卡片显示剩余工时，并以标签显示逾期多久或距截止日期多近。排序：按截止日期时，逾期最久的排在最前。"
          }
        }
      }
    },
    "leaderHelpLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Load all\": counts and filters only cover what is loaded; this reads the rest of the open views."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Load all\": số đếm và bộ lọc chỉ tính phần đã tải; nút này đọc nốt phần còn lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“全部加载”：计数和筛选仅涵盖已加载的内容；此操作会读取其余已打开视图的内容。"
          }
        }
      }
    },
    "leaderHelpMenu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a ticket: Select, Assign… or Priority… without opening it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuột phải vào ticket: Select, Assign… hoặc Priority… mà không cần mở."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点按工单：无需打开即可选择、指派…或设置优先级…。"
          }
        }
      }
    },
    "leaderHelpPeople": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People: click a name to see only their work; ⌘-click adds more people. The number is what they still have open, the red dot means something is overdue. \"Everyone\" clears the pick."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người: bấm tên để chỉ xem việc của họ; ⌘-click để thêm người. Con số là số việc họ còn mở, chấm đỏ là có việc trễ hạn. \"Everyone\" để bỏ chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人员：点按姓名仅查看其工作；⌘-点按可添加更多人员。数字表示其仍未完成的数量，红点表示有逾期项。“所有人”会清除选择。"
          }
        }
      }
    },
    "leaderHelpSelect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick tickets: ⌘-click a card or row, ⇧-click to pick a range. With some picked, a plain click picks too. Esc or Clear drops the pick."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ticket: ⌘-click thẻ hoặc dòng, ⇧-click để chọn một dải. Khi đã chọn, click thường cũng là chọn. Esc hoặc Clear để bỏ chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择工单：⌘-点按卡片或行，⇧-点按可选择一个范围。已有选中项时，普通点按也会选中。按 Esc 或“清除”取消选择。"
          }
        }
      }
    },
    "leaderHelpTeam": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team (header): follow a saved group of people across every execution or product instead of just one. Pick an execution again to leave it."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Team (ở header): theo dõi một nhóm người đã lưu trên mọi execution hoặc product thay vì chỉ một. Chọn lại execution để thoát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队（标题栏）：跨所有执行或产品跟踪已保存的人员分组，而不只是一个。再次选择某个执行即可退出。"
          }
        }
      }
    },
