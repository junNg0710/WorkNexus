    "diagnosticsPerformance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance log"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi log hiệu năng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性能日志"
          }
        }
      }
    },
    "diagnosticsPerformanceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While on, stutters (a scroll that jerks, a frame drawn late) and slow work (opening a chat, loading older messages, decoding pictures) are written to the log with where they happened. Turn it on to trace lag, then export the log. Uses a little more power."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, các lần giật/khựng (cuộn bị giật, khung hình vẽ trễ) và thao tác chậm (mở chat, tải tin cũ, giải mã ảnh) được ghi vào log kèm vị trí xảy ra. Bật lên để truy vết lag, rồi xuất log. Tốn thêm chút pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，卡顿（滚动不顺畅、帧绘制延迟）和慢操作（打开会话、加载更早的消息、解码图片）会连同发生位置一起写入日志。开启它来追踪卡顿，然后导出日志。会略微增加耗电。"
          }
        }
      }
    },
    "diagnosticsPerformanceOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Performance log on"
