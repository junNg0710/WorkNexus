    "gitlabConnectionSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your GitLab server URL and a Personal Access Token (scope: api). Your token is stored in the macOS Keychain — never in the local database."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ máy chủ GitLab và Personal Access Token (scope: api). Token được lưu trong macOS Keychain — không lưu trong cơ sở dữ liệu cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 GitLab 服务器 URL 和个人访问令牌（权限范围：api）。令牌保存在 macOS 钥匙串中，绝不会存入本地数据库。"
          }
        }
      }
    },
