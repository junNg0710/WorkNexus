    "chatReactionsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a reply that is just an emoji as a reaction under the message it answers, and react to messages. ZenTao's own client shows a reaction as an emoji reply."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tin trả lời chỉ có một emoji thành reaction dưới tin được trả lời, và cho thả reaction. Client ZenTao chính thức hiện reaction là một tin trả lời bằng emoji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将仅包含一个表情的回复显示为所回复消息下方的表情回应，并可对消息添加回应。ZenTao 自己的客户端会将回应显示为表情回复。"
          }
        }
      }
    },
